    "Tell us the bundle ID of the app to initiate a direct download. Useful to download apps that are no longer available in App Store.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us the bundle ID of the app to initiate a direct download. Useful to download apps that are no longer available in App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请提供应用的 Bundle ID 以发起直接下载。可用于下载已从 App Store 下架的应用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho biết bundle ID của app để tải trực tiếp. Hữu ích để tải app đã không còn trên App Store."
          }
        }
      }
    },
    "The App Store API can be unstable. Retry if an error occurs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store API can be unstable. Retry if an error occurs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 接口可能不稳定，如遇错误请重试。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "API App Store có thể không ổn định. Thử lại nếu có lỗi."
          }
        }
      }
    },
    "The package can be installed later from the Downloads page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package can be installed later from the Downloads page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件包稍后可以从下载页面安装。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói có thể cài sau từ trang Lượt tải."
          }
        }
      }
    },
    "This account is used to download this package. If you choose to AirDrop, your target device must sign in or previously signed in to this account and have at least one app installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is used to download this package. If you choose to AirDrop, your target device must sign in or previously signed in to this account and have at least one app installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户用于下载此软件包。如果您选择使用 AirDrop，目标设备必须登录或曾登录此账户，并至少安装一个应用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này dùng để tải gói này. Nếu bạn chọn AirDrop, máy nhận phải đang đăng nhập hoặc đã từng đăng nhập tài khoản này và đã cài ít nhất một app."
          }
        }
      }
    },
    "This email is used to sign in to Apple services.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This email is used to sign in to Apple services."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此邮箱用于登录 Apple 服务。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email này dùng để đăng nhập các dịch vụ Apple."
          }
        }
      }
    },
    "This ID, combined with a random seed generated on this device, can be used to download packages from the App Store.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ID, combined with a random seed generated on this device, can be used to download packages from the App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 ID 与在此设备上生成的随机种子结合，可以用于从 App Store 下载软件包。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ID này, kết hợp với mã ngẫu nhiên tạo trên máy này, dùng để tải gói từ App Store."
          }
        }
      }
    },
    "This will reset all your settings and data. The app will close afterwards.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will reset all your settings and data. The app will close afterwards."
