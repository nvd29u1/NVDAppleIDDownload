    "Your account is saved in your Keychain and will be synced across devices with the same iCloud account signed in.": {
      "comment": "A description of how the user's account is stored and synced.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is saved in your Keychain and will be synced across devices with the same iCloud account signed in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
