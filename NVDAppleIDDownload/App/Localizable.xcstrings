    "Changing the device GUID may cause all existing accounts to stop working. Apple limits the number of devices you can sign in with at once.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the device GUID may cause all existing accounts to stop working. Apple limits the number of devices you can sign in with at once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改设备 GUID 可能导致所有现有账户无法使用。Apple 限制了可同时登录的设备数量。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi GUID của máy có thể làm mọi tài khoản hiện có ngừng hoạt động. Apple giới hạn số máy đăng nhập cùng lúc."
          }
        }
