          }
        }
      }
    },
    "This app got NVDAppleIDDownload's own bundle ID (%@), so installing it would replace NVDAppleIDDownload and iOS refuses. Sign NVDAppleIDDownload with another certificate, or use an Apple ID or a wildcard certificate for this app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app got NVDAppleIDDownload's own bundle ID (%@), so installing it would replace NVDAppleIDDownload and iOS refuses. Sign NVDAppleIDDownload with another certificate, or use an Apple ID or a wildcard certificate for this app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App này mang bundle ID của chính NVDAppleIDDownload (%@), nên cài đặt nó sẽ thay thế NVDAppleIDDownload và iOS từ chối. Hãy ký NVDAppleIDDownload bằng một chứng chỉ khác, hoặc dùng Apple ID hay chứng chỉ wildcard cho app này."
          }
        }
      }
    },
    "NVDAppleIDDownload itself has this bundle ID. An app signed with this certificate cannot be installed while NVDAppleIDDownload uses the same ID.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NVDAppleIDDownload itself has this bundle ID. An app signed with this certificate cannot be installed while NVDAppleIDDownload uses the same ID."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính NVDAppleIDDownload mang bundle ID này. App ký bằng chứng chỉ này không thể cài đặt khi NVDAppleIDDownload đang dùng cùng ID đó."
          }
        }
      }
    },
    "Keep the app's own bundle ID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the app's own bundle ID"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ bundle ID gốc của app"
          }
        }
      }
    },
    "This profile is made for %@. The app keeps its own bundle ID, so several apps can be installed side by side; app extensions are removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile is made for %@. The app keeps its own bundle ID, so several apps can be installed side by side; app extensions are removed."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ này được tạo cho %@. App giữ bundle ID gốc của nó, nên có thể cài đặt nhiều app cạnh nhau; phần mở rộng của app sẽ bị gỡ."
          }
        }
      }
    },
    "Apple's profile does not include the UDID %@. Check the UDID in Certificates → Manage Apple ID account and sign in again with the right one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's profile does not include the UDID %@. Check the UDID in Certificates → Manage Apple ID account and sign in again with the right one."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ của Apple không chứa UDID %@. Kiểm tra UDID trong Chứng chỉ → Quản lý tài khoản Apple ID rồi đăng nhập lại bằng UDID đúng."
          }
        }
      }
    },
    "UDID detected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UDID detected"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã phát hiện UDID"
          }
        }
      }
    },
    "Apple needs this iPhone's UDID. Tap Detect: Safari downloads a profile, open Settings → Profile Downloaded → Install, and you come back here with the UDID filled in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple needs this iPhone's UDID. Tap Detect: Safari downloads a profile, open Settings → Profile Downloaded → Install, and you come back here with the UDID filled in."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple cần UDID của iPhone này. Chạm Phát hiện: Safari tải về một hồ sơ, mở Cài đặt → Đã tải về hồ sơ → Cài đặt, rồi bạn quay lại đây với UDID đã điền sẵn."
          }
        }
      }
    },
