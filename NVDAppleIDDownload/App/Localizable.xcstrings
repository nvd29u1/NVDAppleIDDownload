    "Apple rejected the download (code: %@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple rejected the download (code: %@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 拒绝了下载请求（错误码：%@）。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple đã từ chối lượt tải (mã: %@)."
          }
        }
      }
    },
    "Apple requires an account confirmation. Open the App Store with this account, complete any prompts, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple requires an account confirmation. Open the App Store with this account, complete any prompts, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 要求确认账号信息。请使用此账号打开 App Store，完成相关提示后重试。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple yêu cầu xác nhận tài khoản. Mở App Store bằng tài khoản này, làm theo hướng dẫn rồi thử lại."
          }
        }
      }
    },
    "Apple returned an invalid download redirect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple returned an invalid download redirect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 返回了无效的下载重定向地址。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple trả về đường dẫn tải không hợp lệ."
          }
        }
      }
    },
    "Apple returned incomplete or mismatched package information.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple returned incomplete or mismatched package information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 返回的安装包信息不完整或与请求的 App 不符。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple trả về thông tin gói chưa đầy đủ hoặc không khớp."
          }
        }
      }
    },
    "Apple returned no downloadable package from either download service. This does not mean the app does not exist. Check this account's license, store region, and the requested version. See Settings > Logs for details.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple returned no downloadable package from either download service. This does not mean the app does not exist. Check this account's license, store region, and the requested version. See Settings > Logs for details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 的两个下载接口均未返回可下载的安装包。这不代表 App 不存在。请检查当前账号的许可、商店地区及所选版本，详情见“设置 > 日志”。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple không trả về gói tải được từ cả hai dịch vụ tải. Không có nghĩa là app không tồn tại. Kiểm tra giấy phép của tài khoản, vùng Store và phiên bản đã chọn. Xem Cài đặt > Nhật ký để biết chi tiết."
          }
        }
      }
    },
    "Apple returned no version history for this app and platform.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple returned no version history for this app and platform."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回此 App 在所选平台上的历史版本。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple không trả về lịch sử phiên bản cho app và nền tảng này."
          }
        }
      }
    },
    "Apple's download service returned an invalid response (HTTP %lld).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
