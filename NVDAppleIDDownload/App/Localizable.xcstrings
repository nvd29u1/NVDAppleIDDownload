          }
        }
      }
    },
    "iOS only installs apps over HTTPS. NVDAppleIDDownload made a private certificate authority on this iPhone, its key never leaves the device. Trust it once and installs work offline forever.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS only installs apps over HTTPS. NVDAppleIDDownload made a private certificate authority on this iPhone, its key never leaves the device. Trust it once and installs work offline forever."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chỉ cài đặt app qua HTTPS. NVDAppleIDDownload đã tạo một cơ quan chứng chỉ riêng trên iPhone này, khoá của nó không bao giờ rời khỏi thiết bị. Tin cậy một lần là cài đặt ngoại tuyến mãi mãi."
          }
        }
      }
