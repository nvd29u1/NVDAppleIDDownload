    "Accounts are stored securely in your Keychain and can be removed at any time from the detail view.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts are stored securely in your Keychain and can be removed at any time from the detail view."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的账户安全储存在系统钥匙串中，可随时删除。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản được lưu an toàn trong Keychain và có thể xoá bất cứ lúc nào trong trang chi tiết."
          }
        }
      }
    },
    "Acquire License": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquire License"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取许可证"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lấy giấy phép"
          }
        }
      }
    },
    "Acquiring a license is not available for paid apps. Purchase from the App Store first, then download here. If you've already purchased it, this may fail.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquiring a license is not available for paid apps. Purchase from the App Store first, then download here. If you've already purchased it, this may fail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付费应用不支持获取许可证。请先在 App Store 购买，然后在此下载。如果您已购买，此操作可能失败。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lấy được giấy phép cho app trả phí. Hãy mua trên App Store trước, rồi tải ở đây. Nếu bạn đã mua rồi mà vẫn lỗi thì thử lại."
          }
        }
      }
    },
    "Add Account": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
